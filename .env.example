# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openlynk"

# Better Auth Configuration
BETTER_AUTH_SECRET=""          # Generate: openssl rand -hex 32
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend Email Provider
# Daftar & dapatkan API key di: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="OpenLynk <noreply@yourdomain.com>"

# ImageKit
# Dapatkan dari: https://imagekit.io/dashboard/developer/api-keys
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxx"
